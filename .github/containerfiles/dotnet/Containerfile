ARG DOTNET_VERSION=8.0
ARG APP_PROJECT=src/App/App.csproj

FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_VERSION} AS build
WORKDIR /src

# Optional auth args for private feed restores referenced by NuGet.Config.
ARG NUGET_AUTH_TOKEN=
ARG GITHUB_PACKAGES_TOKEN=
ARG GITHUB_USERNAME=
ENV NUGET_AUTH_TOKEN=${NUGET_AUTH_TOKEN}
ENV GITHUB_PACKAGES_TOKEN=${GITHUB_PACKAGES_TOKEN}
ENV GITHUB_USERNAME=${GITHUB_USERNAME}

COPY . .

RUN dotnet restore "${APP_PROJECT}"
RUN dotnet publish "${APP_PROJECT}" -c Release -o /app/publish --no-restore /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:${DOTNET_VERSION} AS runtime
WORKDIR /app

ENV ASPNETCORE_URLS=http://+:80
EXPOSE 80

COPY --from=build /app/publish ./

# Resolve startup assembly from published runtimeconfig when no app name is provided.
RUN cat > /entrypoint.sh <<'SCRIPT' && chmod +x /entrypoint.sh
#!/usr/bin/env sh
set -eu

if [ -n "${APP_DLL:-}" ]; then
  exec dotnet "/app/${APP_DLL}"
fi

startup="$(find /app -maxdepth 1 -type f -name '*.runtimeconfig.json' | head -n 1)"
if [ -z "${startup}" ]; then
  echo "No *.runtimeconfig.json found in /app"
  exit 1
fi

app_name="$(basename "${startup}" .runtimeconfig.json)"
exec dotnet "/app/${app_name}.dll"
SCRIPT

ENTRYPOINT ["/entrypoint.sh"]
