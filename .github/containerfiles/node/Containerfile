ARG NODE_VERSION=20

FROM node:${NODE_VERSION}-alpine AS base

# Install dependencies in a separate stage to maximize layer caching.
FROM base AS deps
WORKDIR /app

COPY . .

RUN corepack enable

RUN if [ -f pnpm-lock.yaml ]; then \
      corepack prepare pnpm@latest --activate && pnpm install --frozen-lockfile; \
    elif [ -f yarn.lock ]; then \
      corepack prepare yarn@latest --activate && yarn install --immutable; \
    elif [ -f package-lock.json ]; then \
      npm ci; \
    else \
      npm install; \
    fi

# Build the application and prune dev dependencies.
FROM base AS builder
WORKDIR /app

COPY --from=deps /app ./

RUN corepack enable

RUN if [ -f pnpm-lock.yaml ]; then \
      corepack prepare pnpm@latest --activate && pnpm run build; \
    elif [ -f yarn.lock ]; then \
      corepack prepare yarn@latest --activate && yarn run build; \
    else \
      npm run build; \
    fi

RUN if [ -f pnpm-lock.yaml ]; then \
      corepack prepare pnpm@latest --activate && pnpm prune --prod; \
    elif [ -f yarn.lock ]; then \
      corepack prepare yarn@latest --activate && yarn workspaces focus --production || yarn install --production --immutable; \
    elif [ -f package-lock.json ]; then \
      npm prune --omit=dev; \
    else \
      npm prune --omit=dev; \
    fi

# Minimal runtime image.
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=80

# Run as a non-root user for better security.
RUN addgroup -g 1001 app && adduser -D -u 1001 -G app appuser

COPY --from=builder /app ./

USER appuser
EXPOSE 80

CMD ["npm","run","start"]
